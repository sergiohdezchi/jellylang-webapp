<%# Plantilla común de los correos. HTML de correo: tablas y estilos en línea para que se vea igual en Gmail, Outlook y Apple Mail. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= message.subject %></title>
    <style>
      @media only screen and (max-width: 600px) {
        .card { border-radius: 0 !important; }
        .px { padding-left: 24px !important; padding-right: 24px !important; }
        .hero-mark { display: none !important; }
        .code { font-size: 34px !important; letter-spacing: 8px !important; }
      }
      a { color: #5b34ea; }
    </style>
  </head>
  <body style="margin:0;padding:0;background-color:#f5f6fd;-webkit-text-size-adjust:100%;">
    <% if @preheader %>
      <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;"><%= @preheader %>&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
    <% end %>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f6fd" style="background-color:#f5f6fd;">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff"
                 style="max-width:560px;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 6px 24px rgba(12,25,68,0.08);">
            <tr>
              <td height="6" bgcolor="#6540f7" style="height:6px;line-height:6px;font-size:0;background-color:#6540f7;background-image:linear-gradient(90deg,#3b82f6 0%,#6540f7 55%,#b765f5 100%);">&nbsp;</td>
            </tr>
            <tr>
              <td class="px" style="padding:28px 40px 8px;">
                <a href="<%= app_url %>" style="text-decoration:none;">
                  <img src="<%= app_url %>/logo.png" width="150" alt="Jellylang"
                       style="display:block;width:150px;max-width:150px;height:auto;border:0;font-family:Arial,sans-serif;font-size:24px;font-weight:700;color:#5b34ea;">
                </a>
              </td>
            </tr>
            <%= yield %>
            <tr>
              <td class="px" style="padding:24px 40px 32px;border-top:1px solid #eceefa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#5a6388;">
                <strong style="color:#0c1944;">Jellylang</strong> · <%= t("mailers.tagline") %><br>
                <%= t("mailers.footer_signup") %><br>
                <a href="<%= app_url %>" style="color:#5b34ea;text-decoration:none;"><%= app_url.sub(%r{\Ahttps?://}, "") %></a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
