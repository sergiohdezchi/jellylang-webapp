<% font = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif" %>
<tr>
  <td class="px" style="padding:16px 40px 8px;font-family:<%= font %>;color:#0c1944;">
    <h1 style="margin:0 0 12px;font-size:26px;line-height:1.25;font-weight:800;"><%= t("mailers.password_reset.title") %></h1>
    <p style="margin:0;font-size:16px;line-height:1.6;color:#3b4570;"><%= t("mailers.password_reset.intro") %></p>
  </td>
</tr>
<tr>
  <td class="px" style="padding:20px 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ebe7fe" style="background-color:#ebe7fe;border-radius:14px;border:1px solid #d9d1fd;">
      <tr>
        <td align="center" style="padding:26px 12px;">
          <div class="code" style="font-family:'SFMono-Regular',Menlo,Consolas,'Liberation Mono',monospace;font-size:40px;line-height:1;font-weight:700;letter-spacing:12px;color:#4623c8;padding-left:12px;"><%= @code %></div>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td class="px" style="padding:0 40px 28px;font-family:<%= font %>;font-size:14px;line-height:1.6;color:#5a6388;">
    <p style="margin:0 0 8px;">⏱ <%= t("mailers.password_reset.expires", minutes: @minutes) %></p>
    <p style="margin:0;"><%= t("mailers.password_reset.ignore") %></p>
  </td>
</tr>
