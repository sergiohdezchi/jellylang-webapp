# Copia este archivo a .env en el servidor y completa los valores:
#   cp .env.production.example .env
# Genera cada secreto con:  openssl rand -hex 64

# --- Obligatorios ---
DB_PASSWORD=
SECRET_KEY_BASE=
JWT_SECRET=

# Nombre de la red de Docker que comparte Caddy (docker network ls)
PROXY_NETWORK=proxy

# --- Usuarios iniciales (seeds, se crean al primer arranque) ---
# Si no defines una contraseña, se genera una aleatoria y se imprime una sola vez:
#   docker compose -f docker-compose.prod.yml logs jellylang-api | grep -i "contraseña"
ADMIN_EMAIL=admin@jellylang.com
ADMIN_PASSWORD=
EXAMPLE_EMAIL=example@jellylang.com
EXAMPLE_PASSWORD=

# --- Opcionales ---
DB_USER=jellylang
# Registro abierto a cualquiera (también se cambia desde el panel de administración)
SIGNUPS_ENABLED=true
# yt-dlp: el servidor consulta a YouTube por su cuenta (apagado por defecto; se cambia desde /admin)
YTDLP_ENABLED=false
# Traducción: con DEEPL_API_KEY se usa DeepL; vacío = MyMemory (gratis)
DEEPL_API_KEY=

# --- Correo (Zoho Mail): bienvenida al registrarse ---
# Sin SMTP_USERNAME y SMTP_PASSWORD no se envía ningún correo (el registro funciona igual).
# Usuario = la dirección completa de Zoho. Con verificación en dos pasos hace falta una "contraseña de aplicación"
# (Zoho > Mi cuenta > Seguridad > Contraseñas de aplicación).
# SMTP_ADDRESS debe ser el de la región de tu cuenta: smtp.zoho.com, smtp.zoho.eu, smtp.zoho.in, smtp.zoho.com.au, smtp.zoho.jp
SMTP_ADDRESS=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Remitente. Zoho solo permite la propia cuenta o uno de sus alias. Vacío = SMTP_USERNAME.
MAIL_FROM=
# Dirección pública de la web (enlace del botón del correo)
APP_URL=https://jellylang.com
